@model ToDoList.Models.Task
<div class="container py-4">
    <div class="card shadow border-0 rounded-4 mx-auto" style="max-width: 600px;">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h4 class="mb-0">
                <i class="bi bi-pencil-square text-warning"></i> Edit Task
            </h4>
        </div>

        <div class="card-body px-4 pb-4">
            <form method="post" enctype="multipart/form-data">
                <input name="Id" value="@Model.Id" hidden=""></input>
                <div class="mb-3">
                    <label for="title" class="form-label fw-semibold">Title</label>
                    <input type="text" id="title" name="Title"  value="@Model.Title" class="form-control">
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label fw-semibold">Description</label>
                    <textarea id="description" name="Description"  class="form-control" rows="3">@Model.Description</textarea>
                </div>

                <div class="mb-3">
                    <input type="datetime-local" name="DeadLine" id="deadline"
                           value="@Model.DeadLine.ToString("yyyy-MM-ddTHH:mm")"
                           class="form-control">
                </div>

                <div class="mb-4">
                    <label for="file" class="form-label fw-semibold">File</label>
                    <input type="file" id="file" name="ActualFile" class="form-control">
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-controller="Task" asp-action="Index" class="btn btn-secondary">
                        Back
                    </a>
                    <button type="submit" class="btn btn-warning">
                        Update
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>